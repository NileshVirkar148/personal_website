---
import Layout from '../layouts/Layout.astro';

const title = "Home";
---

<Layout title={title} heroNav={true}>
	<!-- HERO -->
	<section class="hero">
		<div class="hero-image-bg">
			<img src="/hero-bg.jpeg" alt="Nilesh Virkar" class="hero-photo" />
		</div>
		<div class="hero-overlay"></div>
		<div class="hero-content">
			<div class="hero-text-block">
				<span class="hero-eyebrow">AI-focused Software Architect</span>
				<h1 class="hero-title">Hi, I'm<br/><span class="hero-name">Nilesh Virkar</span></h1>
				<p class="hero-description">
					I build intelligent developer tools, integrate LLMs into scalable systems,
					and bridge the gap between software engineering and real-world AI.
				</p>
				<div class="hero-actions">
					<a href="/profile" class="btn btn-primary">About Me</a>
					<a href="/resume" class="btn btn-outline">View Resume</a>
				</div>
			</div>
		</div>
		<div class="hero-scroll-hint">
			<span>Scroll</span>
			<div class="scroll-line"></div>
		</div>
	</section>

	<!-- WHAT I DO -->
	<section class="section section-light">
		<div class="container">
			<div class="section-header">
				<span class="section-label">What I Do</span>
				<h2 class="section-title">Building at the intersection of<br/>AI & Systems Engineering</h2>
			</div>
			<div class="cards-grid">
				<div class="card">
					<div class="card-icon">⚙️</div>
					<h3>System Architecture</h3>
					<p>Designing scalable, resilient backend systems with a focus on performance, observability, and maintainability.</p>
					<a href="/profile" class="card-link">Learn more →</a>
				</div>
				<div class="card">
					<div class="card-icon">🤖</div>
					<h3>AI & LLM Integration</h3>
					<p>Integrating large language models into production workflows — from RAG pipelines to intelligent developer tooling.</p>
					<a href="/profile" class="card-link">Learn more →</a>
				</div>
				<div class="card">
					<div class="card-icon">✍️</div>
					<h3>Writing & Sharing</h3>
					<p>Documenting experiments, learnings, and opinions on AI, software design, and the future of engineering.</p>
					<a href="/blog" class="card-link">Read the blog →</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT SNAPSHOT -->
	<section class="section section-dark">
		<div class="container about-split">
			<div class="about-text">
				<span class="section-label light">About Me</span>
				<h2 class="section-title light">Software engineer.<br/>AI builder. Problem solver.</h2>
				<p class="about-body">
					I'm passionate about combining deep engineering fundamentals with modern AI to create tools that actually matter.
					Whether it's designing distributed systems or prototyping the next LLM-powered assistant, I care about craft, clarity, and impact.
				</p>
				<a href="/profile" class="btn btn-primary-light">My Full Story</a>
			</div>
			<div class="about-resume-cta">
				<div class="resume-card">
					<p class="resume-card-label">Want the details?</p>
					<h3 class="resume-card-title">My Resume</h3>
					<p class="resume-card-body">Years of experience in backend engineering, AI integrations, and system design — all in one place.</p>
					<a href="/resume" class="btn btn-white">View Resume →</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* ── HERO ── */
	.hero {
		position: relative;
		height: 100vh;
		min-height: 600px;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero-image-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	/* gradient from transparent on left to deep navy on right, letting person show on left */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			255deg,
			rgba(15, 15, 40, 0.92) 0%,
			rgba(15, 15, 40, 0.75) 45%,
			rgba(15, 15, 40, 0.15) 72%,
			transparent 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1200px;
		width: 100%;
		margin: 0 auto;
		padding: 0 2rem;
		padding-top: 5rem;
		display: flex;
		justify-content: flex-end;
	}

	.hero-text-block {
		max-width: 480px;
		width: 100%;
	}

	.hero-eyebrow {
		display: inline-block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #7eb8f7;
		margin-bottom: 1rem;
		padding: 0.35rem 0.9rem;
		background: rgba(126, 184, 247, 0.15);
		border: 1px solid rgba(126, 184, 247, 0.3);
		border-radius: 100px;
	}

	.hero-title {
		font-size: clamp(2.8rem, 6vw, 5rem);
		font-weight: 700;
		line-height: 1.1;
		color: white;
		margin: 0 0 1.5rem;
		letter-spacing: -0.03em;
	}

	.hero-name {
		background: linear-gradient(135deg, #7eb8f7 0%, #b794f4 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-description {
		font-size: 1.1rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.75);
		max-width: 420px;
		margin: 0 0 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.hero-scroll-hint {
		position: absolute;
		bottom: 2.5rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		color: rgba(255,255,255,0.4);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.scroll-line {
		width: 1px;
		height: 40px;
		background: linear-gradient(to bottom, rgba(255,255,255,0.4), transparent);
		animation: scrollPulse 2s ease-in-out infinite;
	}

	@keyframes scrollPulse {
		0%, 100% { opacity: 0.4; transform: scaleY(1); }
		50% { opacity: 1; transform: scaleY(1.2); }
	}

	/* ── BUTTONS ── */
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.8rem 1.8rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		transition: all 0.25s ease;
		cursor: pointer;
		border: none;
	}

	.btn-primary {
		background: linear-gradient(135deg, #4a6cf7, #7c4dff);
		color: white;
		box-shadow: 0 4px 20px rgba(74, 108, 247, 0.4);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(74, 108, 247, 0.5);
	}

	.btn-outline {
		background: transparent;
		color: white;
		border: 1.5px solid rgba(255, 255, 255, 0.4);
	}

	.btn-outline:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.8);
	}

	.btn-primary-light {
		background: linear-gradient(135deg, #4a6cf7, #7c4dff);
		color: white;
		box-shadow: 0 4px 20px rgba(74, 108, 247, 0.35);
	}

	.btn-primary-light:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 28px rgba(74, 108, 247, 0.5);
	}

	.btn-white {
		background: white;
		color: #1a1a2e;
		font-weight: 700;
	}

	.btn-white:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0,0,0,0.2);
	}

	/* ── SECTIONS ── */
	.section {
		padding: 6rem 0;
	}

	.section-light {
		background: #FFF7F4;
	}

	.section-dark {
		background: #1a1a2e;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-label {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #4a6cf7;
		margin-bottom: 0.75rem;
	}

	.section-label.light {
		color: #7eb8f7;
	}

	.section-title {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: #1a1a2e;
		margin: 0;
	}

	.section-title.light {
		color: white;
	}

	/* ── CARDS ── */
	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.75rem;
	}

	.card {
		background: white;
		border-radius: 16px;
		padding: 2.25rem;
		border: 1px solid rgba(74, 108, 247, 0.1);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.05);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.card:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 32px rgba(74, 108, 247, 0.15);
	}

	.card-icon {
		font-size: 2rem;
		margin-bottom: 1.25rem;
	}

	.card h3 {
		font-size: 1.15rem;
		font-weight: 700;
		color: #1a1a2e;
		margin: 0 0 0.75rem;
		letter-spacing: -0.02em;
	}

	.card p {
		color: #5a6072;
		line-height: 1.7;
		font-size: 0.95rem;
		margin: 0 0 1.5rem;
	}

	.card-link {
		color: #4a6cf7;
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 0.2s;
	}

	.card-link:hover {
		color: #7c4dff;
	}

	/* ── ABOUT SPLIT ── */
	.about-split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: center;
	}

	.about-text {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.about-body {
		color: rgba(255,255,255,0.7);
		line-height: 1.8;
		font-size: 1rem;
		margin: 0 0 1.5rem;
	}

	.resume-card {
		background: linear-gradient(135deg, rgba(74, 108, 247, 0.25), rgba(124, 77, 255, 0.25));
		border: 1px solid rgba(126, 184, 247, 0.2);
		border-radius: 20px;
		padding: 3rem 2.5rem;
	}

	.resume-card-label {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #7eb8f7;
		margin: 0 0 0.5rem;
	}

	.resume-card-title {
		font-size: 1.8rem;
		font-weight: 700;
		color: white;
		margin: 0 0 1rem;
		letter-spacing: -0.03em;
	}

	.resume-card-body {
		color: rgba(255,255,255,0.65);
		line-height: 1.7;
		font-size: 0.95rem;
		margin: 0 0 2rem;
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 768px) {
		/* Face is on the left side of the image — anchor there */
		.hero-photo {
			object-position: 20% top;
		}

		/* Transparent at top (face shows) → dark at bottom (text readable) */
		.hero-overlay {
			background: linear-gradient(
				to bottom,
				rgba(15, 15, 40, 0.05) 0%,
				rgba(15, 15, 40, 0.08) 28%,
				rgba(15, 15, 40, 0.60) 52%,
				rgba(15, 15, 40, 0.92) 75%,
				rgba(15, 15, 40, 0.97) 100%
			);
		}

		/* Push text block to the bottom so face is visible above */
		.hero {
			align-items: flex-end;
		}

		.hero-content {
			padding: 0 1.5rem 3rem;
			justify-content: flex-start;
		}

		.hero-text-block {
			max-width: 100%;
		}

		.hero-eyebrow {
			font-size: 0.7rem;
			margin-bottom: 0.65rem;
		}

		.hero-title {
			font-size: clamp(1.9rem, 8vw, 2.6rem);
			margin-bottom: 0.85rem;
		}

		.hero-description {
			max-width: 100%;
			font-size: 0.93rem;
			line-height: 1.6;
			margin-bottom: 1.5rem;
		}

		.hero-actions {
			gap: 0.65rem;
		}

		.btn {
			padding: 0.7rem 1.4rem;
			font-size: 0.88rem;
		}

		/* Hide scroll hint on mobile — it would overlap bottom-aligned content */
		.hero-scroll-hint {
			display: none;
		}

		.about-split {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.section {
			padding: 4rem 0;
		}
	}
</style>
