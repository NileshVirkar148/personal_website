---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const title = "Blog";
const posts = await getCollection('blog');

const staticPosts = [
	{
		title: "The Repository That Mapped the Internet for Developers",
		description: "How one GitHub repo with 434,000 stars became the unofficial atlas of the open source world — and why reading it is one of the most valuable things a developer can do in 2025.",
		pubDate: new Date('2025-04-01'),
		slug: '/blog/awesome-github',
		tags: ['Open Source', 'GitHub', 'Developer Culture'],
	}
];
---

<Layout title={title}>
	<section class="blog">
		<header class="blog-header">
			<h1>My Blog</h1>
			<p>Thoughts, tutorials, and insights on technology and development</p>
		</header>

		<div class="posts-grid">
			{staticPosts.map((post) => (
				<article class="post-card featured">
					<div class="post-content">
						<div class="post-tags">
							{post.tags.map(tag => <span class="post-tag">{tag}</span>)}
						</div>
						<h2>
							<a href={post.slug}>{post.title}</a>
						</h2>
						<p class="post-description">{post.description}</p>
						<div class="post-meta">
							<time datetime={post.pubDate.toISOString()}>
								{post.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</time>
						</div>
						<a href={post.slug} class="read-more">Read article →</a>
					</div>
				</article>
			))}

			{posts.map((post) => (
				<article class="post-card">
					<div class="post-content">
						<h2>
							<a href={`/blog/${post.slug}`}>{post.data.title}</a>
						</h2>
						<p class="post-description">{post.data.description}</p>
						<div class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</time>
							{post.data.updatedDate && (
								<span class="updated">
									Updated: {post.data.updatedDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric'
									})}
								</span>
							)}
						</div>
					</div>
					{post.data.heroImage && (
						<div class="post-image">
							<img src={post.data.heroImage} alt={post.data.title} />
						</div>
					)}
				</article>
			))}
		</div>

		{posts.length === 0 && staticPosts.length === 0 && (
			<div class="no-posts">
				<p>No blog posts yet. Check back soon!</p>
			</div>
		)}
	</section>
</Layout>

<style>
	.blog {
		max-width: 1000px;
		margin: 0 auto;
		padding: 5.5rem 1.5rem 4rem;
	}

	.blog-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.blog-header h1 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(2rem, 5vw, 2.8rem);
		color: #1a1a2e;
		font-weight: 700;
		letter-spacing: -0.03em;
		margin-bottom: 0.6rem;
	}

	.blog-header p {
		font-size: 1.05rem;
		color: #7f8c8d;
		margin: 0;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.75rem;
		margin-bottom: 2rem;
	}

	.post-card {
		background: white;
		border-radius: 16px;
		border: 1px solid rgba(74, 108, 247, 0.1);
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.05);
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.post-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 32px rgba(74, 108, 247, 0.15);
	}

	.post-card.featured {
		border-color: rgba(74, 108, 247, 0.25);
		background: linear-gradient(160deg, #ffffff 70%, rgba(74,108,247,0.03) 100%);
	}

	.post-content {
		padding: 1.75rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 0.85rem;
	}

	.post-tag {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #4a6cf7;
		background: rgba(74, 108, 247, 0.08);
		border: 1px solid rgba(74, 108, 247, 0.18);
		padding: 3px 9px;
		border-radius: 100px;
	}

	.post-content h2 {
		margin: 0 0 0.85rem 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.25rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		font-weight: 700;
	}

	.post-content h2 a {
		color: #1a1a2e;
		text-decoration: none;
		transition: color 0.25s;
	}

	.post-content h2 a:hover {
		color: #4a6cf7;
	}

	.post-description {
		color: #5a6072;
		line-height: 1.7;
		font-size: 0.92rem;
		margin-bottom: 1rem;
		flex: 1;
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.8rem;
		color: #7f8c8d;
		margin-bottom: 1rem;
		font-weight: 500;
	}

	.updated {
		font-style: italic;
	}

	.read-more {
		display: inline-block;
		color: #4a6cf7;
		font-weight: 600;
		font-size: 0.88rem;
		text-decoration: none;
		transition: color 0.2s;
		margin-top: auto;
	}

	.read-more:hover {
		color: #7c4dff;
	}

	.post-image {
		height: 200px;
		overflow: hidden;
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s;
	}

	.post-card:hover .post-image img {
		transform: scale(1.05);
	}

	.no-posts {
		text-align: center;
		padding: 3rem;
		color: #7f8c8d;
		font-size: 1.05rem;
	}

	@media (max-width: 768px) {
		.blog {
			padding: 5.5rem 1rem 2.5rem;
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>